
predicate jacop_alldiff(array [int] of var int: x);
predicate jacop_maximum_arg_int(array [int] of var int: x,var int: i,int: offset);
predicate jacop_minimum_arg_int(array [int] of var int: x,var int: i,int: offset);
predicate jacop_maximum_arg_bool(array [int] of var bool: x,var int: i,int: offset);
predicate jacop_minimum_arg_bool(array [int] of var bool: x,var int: i,int: offset);
var 1..5: X_INTRODUCED_16_;
var 1..5: X_INTRODUCED_17_;
var 1..5: X_INTRODUCED_18_;
var 1..5: X_INTRODUCED_19_;
var 1..5: X_INTRODUCED_20_;
var 1..5: pos:: output_var;
var bool: X_INTRODUCED_21_;
var bool: X_INTRODUCED_22_;
var bool: X_INTRODUCED_23_;
var 1..3: bmax:: output_var;
var 1..3: bmin:: output_var;
array [1..5] of var int: x:: output_array([1..5]) = [X_INTRODUCED_16_,X_INTRODUCED_17_,X_INTRODUCED_18_,X_INTRODUCED_19_,X_INTRODUCED_20_];
array [1..3] of var bool: b:: output_array([1..3]) = [X_INTRODUCED_21_,X_INTRODUCED_22_,X_INTRODUCED_23_];
constraint jacop_alldiff(x);
constraint jacop_maximum_arg_int(x,pos,1);
constraint jacop_minimum_arg_int(x,2,1);
constraint jacop_maximum_arg_bool(b,bmax,1);
constraint jacop_minimum_arg_bool(b,bmin,1);
solve  satisfy;
