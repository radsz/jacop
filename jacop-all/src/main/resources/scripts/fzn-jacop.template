#!/bin/bash
cd "$(dirname "$0")"
JACOP_JAR="jacop-all-${project.version}.jar"

# Build classpath from lib/*.jar dynamically
CLASSPATH="$JACOP_JAR"
for jar in lib/*.jar; do
  [ -f "$jar" ] && CLASSPATH="$CLASSPATH${CLASSPATH:+:}$jar"
done

# Platform-specific separator (Windows uses ;)
sep=':'; [[ "$OSTYPE" == "msys" || "$OSTYPE" == "cygwin" || -n "${WINDIR:-}" ]] && sep=';'
if [[ "$sep" == ';' ]]; then
  CLASSPATH=$(echo "$CLASSPATH" | tr ':' ';')
fi

# JVM warnings go to stderr, so that they never mix with the FlatZinc output on stdout
JVM_OPTS=(-XX:+UseSerialGC -Xmx12G -Xss100M -Xlog:disable -Xlog:all=warning:stderr)

# Transparent huge pages for the heap: 2 MB pages cut the TLB misses of JaCoP's randomly read
# heap, about 5 % less solving time on the same search (osolpro benchmarks/narrow-types). The JVM
# uses them where the kernel has transparent huge pages in madvise or always mode
# (/sys/kernel/mm/transparent_hugepage/enabled) and otherwise runs as before. The option exists
# only in the Linux JVM; elsewhere it would stop the JVM from starting.
if [[ "$(uname -s)" == Linux ]]; then
  JVM_OPTS+=(-XX:+UseTransparentHugePages)
fi

# Ahead-of-time cache made by ./fzn-jacop-aot (optional): it cuts JVM start-up and class loading.
# A cache older than the jar was made for another build and is not used.
if [ -f jacop.aot ] && [ jacop.aot -nt "$JACOP_JAR" ]; then
  JVM_OPTS+=(-XX:AOTCache=jacop.aot)
fi

exec java "${JVM_OPTS[@]}" -cp "$CLASSPATH" org.jacop.fz.Fz2jacop "$@"
