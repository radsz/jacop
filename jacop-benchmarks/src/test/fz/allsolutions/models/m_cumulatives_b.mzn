include "globals.mzn";
int: n = 5;
array[1..n] of var 0..3: s;
array[1..n] of int: d = [1, 2, 1, 2, 1];
array[1..n] of int: r = [2, 1, 1, 2, 1];
array[1..n] of var 1..2: m;
constraint cumulatives(s, d, r, m, [2, 3], true);
constraint forall(i in 1..n)(s[i] + d[i] <= 4);
constraint m[1] = 1;
solve satisfy;
