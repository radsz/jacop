
predicate jacop_list_diff2(array [int] of var int: x,array [int] of var int: y,array [int] of var int: lx,array [int] of var int: ly);
array [1..3] of int: h = [1,2,1];
array [1..2] of int: X_INTRODUCED_25_ = [1,1];
array [1..3] of int: X_INTRODUCED_30_ = [-1,-1,-1];
var 0..2: X_INTRODUCED_16_;
var 0..2: X_INTRODUCED_17_;
var 0..2: X_INTRODUCED_18_;
var 0..1: X_INTRODUCED_19_;
var 0..1: X_INTRODUCED_21_;
var 0..2: X_INTRODUCED_22_;
var 0..2: X_INTRODUCED_23_;
var 0..2: X_INTRODUCED_24_;
array [1..3] of var int: x:: output_array([1..3]) = [X_INTRODUCED_16_,X_INTRODUCED_17_,X_INTRODUCED_18_];
array [1..3] of var int: y:: output_array([1..3]) = [X_INTRODUCED_19_,0,X_INTRODUCED_21_];
array [1..3] of var int: w:: output_array([1..3]) = [X_INTRODUCED_22_,X_INTRODUCED_23_,X_INTRODUCED_24_];
constraint jacop_list_diff2(x,y,w,h);
constraint int_lin_le(X_INTRODUCED_25_,[X_INTRODUCED_16_,X_INTRODUCED_22_],3);
constraint int_lin_le(X_INTRODUCED_25_,[X_INTRODUCED_17_,X_INTRODUCED_23_],3);
