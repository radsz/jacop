
predicate jacop_count_var(array [int] of var int: x,var int: y,var int: c);
predicate jacop_atmost(array [int] of var int: x,int: y,int: c);
predicate jacop_atleast(array [int] of var int: x,int: v,int: n);
predicate jacop_count_values_bounds(array [int] of var int: x,array [int] of int: cover,array [int] of int: lbound,array [int] of int: ubound);
