array [1..3] of int: X_INTRODUCED_22_ = [3,2,3];
array [1..3] of int: X_INTRODUCED_23_ = [1,0,0];
array [1..3] of int: X_INTRODUCED_24_ = [1,2,3];
var 1..3: X_INTRODUCED_16_;
var 1..3: X_INTRODUCED_17_;
var 1..3: X_INTRODUCED_18_;
var 1..3: X_INTRODUCED_19_;
var 2..4: nvar:: output_var;
var 1..3: val:: output_var;
var bool: two_threes:: is_defined_var:: output_var;
var bool: few_ones:: is_defined_var:: output_var;
array [1..4] of var int: x:: output_array([1..4]) = [X_INTRODUCED_16_,X_INTRODUCED_17_,X_INTRODUCED_18_,X_INTRODUCED_19_];
