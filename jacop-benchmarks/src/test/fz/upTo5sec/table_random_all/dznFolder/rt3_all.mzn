constraint table([x[2], x[3], x[10]], t1);
constraint table([x[3], x[4], x[9]], t2);
constraint table([x[1], x[3], x[7]], t3);
constraint table([x[3], x[4], x[6]], t4);
constraint table([x[1], x[4], x[5]], t5);
constraint table([x[1], x[5], x[7]], t6);
constraint table([x[4], x[6], x[8]], t7);
constraint table([x[3], x[9], x[10]], t8);
constraint table([x[6], x[7], x[10]], t9);
constraint table([x[6], x[8], x[10]], t10);

solve :: int_search(x, input_order, indomain_min) satisfy;

output ["x = \(x);\n"];
