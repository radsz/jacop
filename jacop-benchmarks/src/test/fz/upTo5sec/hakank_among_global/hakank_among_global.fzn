
predicate jacop_among(array [int] of var int: x,set of int: v,var int: n);
array [1..2] of int: X_INTRODUCED_22_ = [1,-1];
var 0..3: X_INTRODUCED_16_;
var 0..3: X_INTRODUCED_17_;
