% Extensional constraint benchmark, family tsp (n=10 seed=1, seed 1).
% TSP on 10 random points: tour order x with alldifferent, each leg length from a (from, to, length) table.
% Generated by a deterministic Python generator; the search is fixed so that the
% first solution does not depend on propagation strength.

include "table.mzn";
include "alldifferent.mzn";

int: n = 10;
array[1..n] of var 1..n: x;
array[1..n] of var 0..150: d;
array[1..90, 1..3] of int: dist = [|1,2,66|1,3,80|1,4,60|1,5,75|1,6,107|1,7,3|1,8,85|1,9,66|1,10,5|2,1,66|2,3,82|2,4,86|2,5,37|2,6,92|2,7,65|2,8,42|2,9,31|2,10,67|3,1,80|3,2,82|3,4,30|3,5,51|3,6,31|3,7,82|3,8,56|3,9,52|3,10,85|4,1,60|4,2,86|4,3,30|4,5,66|4,6,60|4,7,63|4,8,74|4,9,63|4,10,65|5,1,75|5,2,37|5,3,51|5,4,66|5,6,55|5,7,76|5,8,10|5,9,9|5,10,79|6,1,107|6,2,92|6,3,31|6,4,60|6,5,55|6,7,109|6,8,54|6,9,61|6,10,112|7,1,3|7,2,65|7,3,82|7,4,63|7,5,76|7,6,109|7,8,86|7,9,67|7,10,3|8,1,85|8,2,42|8,3,56|8,4,74|8,5,10|8,6,54|8,7,86|8,9,19|8,10,89|9,1,66|9,2,31|9,3,52|9,4,63|9,5,9|9,6,61|9,7,67|9,8,19|9,10,70|10,1,5|10,2,67|10,3,85|10,4,65|10,5,79|10,6,112|10,7,3|10,8,89|10,9,70|];

constraint x[1] = 1;
constraint alldifferent(x);
constraint x[2] < x[n];
constraint forall(i in 1..n)(table([x[i], x[i mod n + 1], d[i]], dist));

solve :: seq_search([int_search(x, input_order, indomain_min), int_search(d, input_order, indomain_min)]) minimize sum(d);

output ["x = \(x);\nlength = \(sum(d));\n"];
