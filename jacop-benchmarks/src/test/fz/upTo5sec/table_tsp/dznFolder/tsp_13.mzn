% Extensional constraint benchmark, family tsp (n=13 seed=2, seed 2).
% TSP on 13 random points: tour order x with alldifferent, each leg length from a (from, to, length) table.
% Generated by a deterministic Python generator; the search is fixed so that the
% first solution does not depend on propagation strength.

include "table.mzn";
include "alldifferent.mzn";

int: n = 13;
array[1..n] of var 1..n: x;
array[1..n] of var 0..150: d;
array[1..156, 1..3] of int: dist = [|1,2,53|1,3,9|1,4,81|1,5,24|1,6,102|1,7,58|1,8,94|1,9,101|1,10,88|1,11,54|1,12,61|1,13,71|2,1,53|2,3,46|2,4,36|2,5,35|2,6,53|2,7,5|2,8,40|2,9,69|2,10,35|2,11,24|2,12,20|2,13,74|3,1,9|3,2,46|3,4,76|3,5,15|3,6,96|3,7,50|3,8,86|3,9,99|3,10,80|3,11,50|3,12,52|3,13,74|4,1,81|4,2,36|4,3,76|4,5,68|4,6,22|4,7,36|4,8,28|4,9,37|4,10,39|4,11,28|4,12,51|4,13,66|5,1,24|5,2,35|5,3,15|5,4,68|5,6,87|5,7,37|5,8,75|5,9,96|5,10,66|5,11,45|5,12,37|5,13,79|6,1,102|6,2,53|6,3,96|6,4,22|6,5,87|6,7,52|6,8,23|6,9,40|6,10,40|6,11,50|6,12,63|6,13,83|7,1,58|7,2,5|7,3,50|7,4,36|7,5,37|7,6,52|7,8,37|7,9,71|7,10,30|7,11,28|7,12,16|7,13,79|8,1,94|8,2,40|8,3,86|8,4,28|8,5,75|8,6,23|8,7,37|8,9,60|8,10,17|8,11,48|8,12,44|8,13,93|9,1,101|9,2,69|9,3,99|9,4,37|9,5,96|9,6,40|9,7,71|9,8,60|9,10,75|9,11,51|9,12,87|9,13,55|10,1,88|10,2,35|10,3,80|10,4,39|10,5,66|10,6,40|10,7,30|10,8,17|10,9,75|10,11,51|10,12,31|10,13,100|11,1,54|11,2,24|11,3,50|11,4,28|11,5,45|11,6,50|11,7,28|11,8,48|11,9,51|11,10,51|11,12,44|11,13,50|12,1,61|12,2,20|12,3,52|12,4,51|12,5,37|12,6,63|12,7,16|12,8,44|12,9,87|12,10,31|12,11,44|12,13,93|13,1,71|13,2,74|13,3,74|13,4,66|13,5,79|13,6,83|13,7,79|13,8,93|13,9,55|13,10,100|13,11,50|13,12,93|];

constraint x[1] = 1;
constraint alldifferent(x);
constraint x[2] < x[n];
constraint forall(i in 1..n)(table([x[i], x[i mod n + 1], d[i]], dist));

solve :: seq_search([int_search(x, input_order, indomain_min), int_search(d, input_order, indomain_min)]) minimize sum(d);

output ["x = \(x);\nlength = \(sum(d));\n"];
