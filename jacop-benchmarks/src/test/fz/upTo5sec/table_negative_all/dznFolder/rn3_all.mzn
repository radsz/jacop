% Extensional constraint benchmark, family randneg (n=10 d=4 m=14 a=3 t=24 seed=3, seed 3).
% 14 random negative (conflict) tables posted as `not table` of arity 3 with 24 tuples each over 10 variables with domain 0..3.
% Generated by a deterministic Python generator; the search is fixed so that the
% first solution does not depend on propagation strength.

include "table.mzn";

array[1..10] of var 0..3: x;

