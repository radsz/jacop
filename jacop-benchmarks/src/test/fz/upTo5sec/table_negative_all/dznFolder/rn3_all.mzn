constraint not table([x[2], x[7], x[10]], t1);
constraint not table([x[4], x[7], x[8]], t2);
constraint not table([x[5], x[8], x[9]], t3);
constraint not table([x[3], x[6], x[7]], t4);
constraint not table([x[7], x[8], x[9]], t5);
constraint not table([x[1], x[2], x[10]], t6);
constraint not table([x[6], x[8], x[10]], t7);
constraint not table([x[1], x[2], x[5]], t8);
constraint not table([x[1], x[5], x[8]], t9);
constraint not table([x[6], x[9], x[10]], t10);
constraint not table([x[2], x[8], x[10]], t11);
constraint not table([x[5], x[7], x[10]], t12);
constraint not table([x[3], x[4], x[5]], t13);
constraint not table([x[2], x[3], x[5]], t14);

solve :: int_search(x, input_order, indomain_min) satisfy;

output ["x = \(x);\n"];
