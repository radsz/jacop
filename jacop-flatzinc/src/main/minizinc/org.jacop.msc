{
    "id": "org.jacop",
    "name": "JaCoP",
    "description": "JaCoP FlatZinc executable",
    "version": "${project.version}",
    "mznlib": "mznlib",
    "executable": "./fzn-jacop",
    "mznlibVersion": 1,
    "inputType": "FZN",
    "isGUIApplication": false,
    "needsMznExecutable": false,
    "needsPathsFile": false,
    "needsSolns2Out": true,
    "needsStdlibDir": false,
    "tags": ["cp", "int", "float", "set", "restart"],
    "stdFlags": ["-a", "-n", "-s", "-t", "-v", "-f", "-r"],
    "extraFlags": [
        ["-b", "use bounds consistency whenever possible; overrides annotation domain.", "bool", "false"],
        ["-cs", "complementary search; gathers all model, non-defined variables, to create the final search.", "bool", "false"],
        ["--precision", "precision for floating operations; overrides precision definition in search annotation.", "float", "1e-11"],
        ["--format", "defines format (number digits after decimal point); for floating variables.", "float", "1e-11"],
        ["-sat", "use SAT solver for boolean constraints.", "bool", "false"],
        ["--lcg", "solve with lazy clause generation (integer and Boolean models).", "bool", "false"],
        ["--presolve", "presolve the model before search; check also checks every solution against the loaded model", "opt:off:on:check", "off"],
        ["--presolve-tabling", "with --presolve, replace small groups of constraints by the tables of their solutions", "bool", "false"],
        ["--presolve-dual", "dual reductions in presolve, only when one solution or an optimum is searched for", "opt:on:off", "on"],
        ["--decay", "decay factor for accumulated failure count (afc) and activity-based variable selection heuristic", "float", "0.99"],
        ["--step", "distance step for cost function for floating-point optimization (0 means 'minimal distance')", "float", "0"],
        ["--restart", "Restart search type", "opt:none:constant:linear:luby:geometric", "none"],
        ["--restart-base", "Base for geometric restart search", "float", "1.5"],
        ["--restart-scale", "Scale factor for restart search", "int", "250"],
        ["--restart-limit", "limits number of restarts in restart search.", "int", "0"],
        ["--free-engine", "engine for free search (-f)", "opt:new:legacy", "new"],
        ["--default-search", "search for a model without search annotation: free (as with -f) or input (input order, splitting domains)", "opt:free:input", "free"],
        ["--free-config", "settings of the new free search engine as key=value,...; see fzn-jacop -h", "string", ""],
        ["-debug", "print the constraints as imposed in JaCoP and the search used.", "bool", "false"]
    ]
}
